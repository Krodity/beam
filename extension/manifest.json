{
  "manifest_version": 3,
  "name": "Beam host",
  "version": "1.0.0",
  "description": "Lets the Beam Android app send any web page's video to this browser and control playback.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "webNavigation",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "options.html",
    "default_title": "Beam host"
  }
}
